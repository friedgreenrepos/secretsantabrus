# Postgres connection string (Neon on Vercel, local Docker in dev)
DATABASE_URL=postgres://santa:santa@localhost:5433/santabrus

# Public base URL used in email links (on Vercel this falls back to the production domain)
APP_URL=http://localhost:3000

# Gmail sender. Leave empty in dev: emails are then written to .emails/ instead of sent.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me
